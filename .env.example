# Copy this file to ".env" and fill in real values locally.
# .env is NEVER committed and agents never read it (see AGENTS.md).
SECRET_KEY=change-me-in-your-real-env
DEBUG=True
DJANGO_SETTINGS_MODULE=config.settings.development
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL / Redis (local defaults; docker-compose overrides hostnames)
DATABASE_URL=postgres://mizban:mizban@localhost:5432/mizban
REDIS_URL=redis://localhost:6379/0
CACHE_URL=redis://localhost:6379/1
CELERY_BROKER_URL=redis://localhost:6379/0

# docker-compose database bootstrap
POSTGRES_DB=mizban
POSTGRES_USER=mizban
POSTGRES_PASSWORD=mizban-dev-password

# SMS provider (OTP login) - placeholders only, real keys stay in .env
SMS_API_KEY=placeholder-ask-provider
SMS_OTP_TEMPLATE=mizban-otp

# Payment gateway (ZarinPal / Sadad / Behpardakht) - TEST keys only in dev
PAYMENT_GATEWAY_MERCHANT_ID=test-merchant-id
PAYMENT_GATEWAY_API_KEY=test-only-key

# Error monitoring (optional locally)
SENTRY_DSN=
