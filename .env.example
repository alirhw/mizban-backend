# Copy this file to ".env" and fill in real values locally.
# .env is NEVER committed and agents never read it (see AGENTS.md).
SECRET_KEY=change-me-in-your-real-env
DEBUG=True
DJANGO_SETTINGS_MODULE=config.settings.development
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL / Redis (local defaults; docker-compose overrides hostnames)
DATABASE_URL=postgres://mizban:mizban@localhost:5432/mizban
REDIS_URL=redis://localhost:6379/0
CACHE_URL=redis://localhost:6379/1
CELERY_BROKER_URL=redis://localhost:6379/0

# docker-compose database bootstrap
POSTGRES_DB=mizban
POSTGRES_USER=mizban
POSTGRES_PASSWORD=mizban-dev-password

# SMS provider (OTP login) - placeholders only, real keys stay in .env
SMS_SENDER=console
OTP_TTL_SECONDS=120
SMS_API_KEY=placeholder-ask-provider
SMS_OTP_TEMPLATE=mizban-otp

# Payment gateway (sandbox in MVP; real gateway post-MVP) - TEST keys only
PAYMENT_GATEWAY_PROVIDER=sandbox
PAYMENT_GATEWAY_TIMEOUT_SECONDS=8.0
PAYMENT_GATEWAY_CALLBACK_BASE_URL=http://127.0.0.1:8000
SANDBOX_BASE_URL=https://sandbox.mizban.local
PAYMENT_GATEWAY_MERCHANT_ID=test-merchant-id
PAYMENT_GATEWAY_API_KEY=test-only-key

# Frontend SSR internal proxy target
BACKEND_INTERNAL_URL=http://127.0.0.1:8000
API_INTERNAL_URL=http://127.0.0.1:8000/api/v1

# Error monitoring & observability (optional locally; Task T-031)
ENVIRONMENT=development
APP_RELEASE=mizban-backend@0.1.0
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
