# Public browser API base URL (proxied same-origin via next.config.ts rewrites in dev, or full origin if CORS is configured)
NEXT_PUBLIC_API_URL=/api/v1

# Server-side internal backend URL used by Next.js SSR and dev proxy rewrites
API_INTERNAL_URL=http://127.0.0.1:8000/api/v1
BACKEND_INTERNAL_URL=http://127.0.0.1:8000
